# Server
PORT=4000
NODE_ENV=development

# Database (Veta Wallet's own, separate from GENESIS ID's)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veta_wallet_db
DB_USER=postgres
DB_PASSWORD=

# Veta Wallet's own session token (independent from GENESIS ID's JWT secret)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=24h

# GENESIS ID — the shared identity provider. GENESIS_API_KEY comes from
# GENESIS ID admin panel: Settings -> Connect New App (appName: veta-wallet)
GENESIS_API_URL=http://localhost:3000/api
GENESIS_API_KEY=

# Allowed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:3002
