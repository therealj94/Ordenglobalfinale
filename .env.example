# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database (AWS RDS PostgreSQL)
DB_HOST=your-rds-host.amazonaws.com
DB_PORT=5432
DB_NAME=genesis_id_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# Email (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@ordenGlobal.com

# Frontend URLs (for redirects)
FRONTEND_URL=http://localhost:3000
VETA_WALLET_URL=http://localhost:3001
MY_TOKEN_PAY_URL=http://localhost:3002

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Logging
LOG_LEVEL=debug

# Admin
ADMIN_EMAIL=admin@ordenGlobal.com
ADMIN_PASSWORD=change_this_in_production
